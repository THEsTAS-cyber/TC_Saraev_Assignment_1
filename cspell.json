{
  "version": "0.2",
  "language": "en,ru",
  "dictionaryDefinitions": [
    {
      "name": "ru_ru",
      "path": "./node_modules/@cspell/dict-ru_ru/cspell-ext.json",
      "addWords": true
    }
  ],
  "dictionaries": ["ru_ru", "en_US"],
  "words": [
    "Innopolis",
    "Saraev",
    "Stanislav",
    "Infostyle",
    "Ozon",
    "Ilyakhov",
    "onboarding",
    "shortcodes",
    "parentheticals",
    "Vercel",
    "Netlify",
    "MobaXterm",
    "Mbps",
    "alllowercase"
  ],
  "ignorePaths": [
    "node_modules",
    "public",
    "resources",
    ".vale"
  ],
  "ignoreRegExpList": [
    "https?://[^\\s]+",
    "`[^`]+`",
    "\\[([^\\]]+)\\]\\([^\\)]+\\)",
    "<!--.*?-->"
  ]
}